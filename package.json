{
  "name": "doramonitor",
  "version": "1.0.0",
  "description": "DoraMonitor — local, privacy-safe usage dashboard for AI coding tools (Kimi Code, ZCode, QoderCN, QoderCN CLI, Codex)",
  "main": "src/server.js",
  "type": "commonjs",
  "bin": {
    "doramonitor": "src/doramonitor.js"
  },
  "files": [
    "src",
    "dist",
    "scripts",
    "assets",
    "docs",
    "README.md",
    "README.zh-CN.md",
    "NOTICE"
  ],
  "scripts": {
    "start": "node src/server.js",
    "dev": "concurrently -k -n api,web -c cyan,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:web": "vite",
    "dev:api": "node src/server.js --port 3847 --no-open",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test",
    "status": "node src/cli.js",
    "daemon": "node src/cli.js daemon",
    "prepack": "npm test && npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DoraJasmine/DoraMonitor.git"
  },
  "homepage": "https://github.com/DoraJasmine/DoraMonitor#readme",
  "bugs": "https://github.com/DoraJasmine/DoraMonitor/issues",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "doramonitor",
    "ai-usage",
    "token-usage",
    "kimi-code",
    "codex",
    "usage-dashboard",
    "pricing"
  ],
  "author": "DoraJasmine",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "fzstd": "^0.1.1",
    "smol-toml": "^1.7.1"
  },
  "devDependencies": {
    "@lobehub/icons": "^5.15.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-shell": "^2.3.5",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.21",
    "class-variance-authority": "^0.7.1",
    "classnames": "^2.5.1",
    "clsx": "^2.1.1",
    "concurrently": "^9.2.4",
    "dayjs": "^1.11.19",
    "framer-motion": "^12.23.12",
    "lucide-react": "^0.542.0",
    "postcss": "^8.5.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^3.4.17",
    "vite": "^6.4.1"
  }
}
